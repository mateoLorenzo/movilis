{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "strict": true
  },
  "include": ["*.ts", "modules/**/*.ts"],
  "exclude": ["dist", "test", "**/*.test.ts", "vitest*.ts"]
}
