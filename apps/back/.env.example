DATABASE_URL=postgres://postgres:postgres@localhost:5432/movilis
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/movilis_test
# Required: generate a unique value with `openssl rand -base64 32`.
# JWT_SECRET=

# Optional server port and auth TTL overrides, in seconds.
# NODE_ENV=development
# PORT=8080
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# OTP_TTL_SECONDS=600

# Local/dev only: include OTP codes in /auth/otp/request responses.
# AUTH_EXPOSE_DEV_OTP_CODE=true
