DATABASE_URL=postgres://postgres:postgres@localhost:5432/movilis
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/movilis_test
# Required: generate a unique value with `openssl rand -base64 32`.
# JWT_SECRET=

# Runtime and server settings.
# NODE_ENV=development
# PORT=8080
# AUTH_TRUST_PROXY must contain only controlled proxy addresses/CIDRs,
# separated by commas. Leave empty when the app receives traffic directly.
AUTH_TRUST_PROXY=

# Auth TTLs, windows, limits, and retention settings.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# OTP_TTL_SECONDS=600
# AUTH_RESEND_COOLDOWN_SECONDS=60
# AUTH_PHONE_WINDOW_SECONDS=900
# AUTH_PHONE_WINDOW_MAX_REQUESTS=3
# AUTH_IP_WINDOW_SECONDS=900
# AUTH_IP_WINDOW_MAX_REQUESTS=10
# AUTH_DEVICE_WINDOW_SECONDS=900
# AUTH_DEVICE_WINDOW_MAX_REQUESTS=5
# AUTH_MAX_OTP_ATTEMPTS=3
# AUTH_OTP_RETENTION_SECONDS=86400
# AUTH_SESSION_RETENTION_SECONDS=2592000
# AUTH_CLEANUP_BATCH_SIZE=500

# Dedicated secrets are required in production, must differ from each other,
# and must not reuse JWT_SECRET. Generate each with `openssl rand -base64 32`.
OTP_CODE_HMAC_SECRET=
AUTH_RATE_LIMIT_HMAC_SECRET=

# Twilio credentials and exactly one sender are required in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_TIMEOUT_MS=10000

# Local/dev only: include OTP codes in /auth/otp/request responses.
# AUTH_EXPOSE_DEV_OTP_CODE=true
